{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GloveBox Tool Registry Schema",
  "description": "Master registry of 1,729 capabilities available in BlackRoad OS",
  "type": "object",
  "required": ["schema_version", "last_updated", "total_tools", "tools"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of this schema"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "Date tools were last synchronized"
    },
    "total_tools": {
      "type": "integer",
      "description": "Total number of tools catalogued"
    },
    "note": {
      "type": "string",
      "description": "Usage notes for maintainers"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "status", "tier"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+\\.[a-z0-9.]+$",
            "description": "Unique tool identifier (e.g., exec.shell, model.qwen, api.http)"
          },
          "name": {
            "type": "string",
            "description": "Human-readable tool name"
          },
          "version": {
            "type": "string",
            "description": "Current version of this tool"
          },
          "category": {
            "type": "string",
            "enum": [
              "OS",
              "Execution",
              "Model",
              "API",
              "Storage",
              "Auth",
              "Network",
              "Media",
              "Math",
              "Data",
              "Crypto"
            ],
            "description": "Functional category"
          },
          "status": {
            "type": "string",
            "enum": ["REAL", "MOCK", "PLANNED"],
            "description": "Implementation status"
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "description": "Access tier (0=public, 1=auth, 2=approved, 3=gated, 4=critical, 5=operator-only)"
          },
          "description": {
            "type": "string",
            "description": "What this tool does"
          },
          "requires_carkeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Which CarKeys lanes must grant access (e.g., ['carkeys.operator-deploy', 'carkeys.model-execution'])"
          },
          "requires_agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Which agents are certified to use this tool"
          },
          "used_by_products": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Products that depend on this tool"
          },
          "sandbox_level": {
            "type": "string",
            "enum": ["none", "container", "vm", "isolated-process"],
            "description": "Execution isolation requirement"
          },
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Security/stability risk assessment"
          },
          "receipt_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Receipt event types this tool generates (e.g., 'TOOL_EXECUTED', 'MODEL_INFERENCE')"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Other tools this depends on (e.g., ['exec.shell', 'storage.indexeddb'])"
          },
          "config_schema": {
            "type": "object",
            "description": "Configuration parameters accepted by this tool"
          }
        }
      }
    }
  }
}
