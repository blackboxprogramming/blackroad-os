{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoadChain Receipt Schema",
  "description": "Immutable append-only receipt ledger format for RoadChain (app 11)",
  "type": "object",
  "required": ["schema_version", "receipts"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "receipt_id",
          "timestamp",
          "chain_hash",
          "prior_hash",
          "subject",
          "action",
          "product"
        ],
        "properties": {
          "receipt_id": {
            "type": "string",
            "pattern": "^REC-[0-9]{4}-[A-Z0-9]{8}$",
            "description": "Unique receipt identifier (REC-YYYY-XXXXXXXX)"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of receipt creation"
          },
          "chain_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hash of this receipt block"
          },
          "prior_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hash of previous receipt in chain"
          },
          "subject": {
            "type": "string",
            "description": "Who performed this action (operator, agent, system)"
          },
          "action": {
            "type": "string",
            "enum": [
              "OPERATOR_SET",
              "OPERATOR_HANDOFF",
              "PRODUCT_LAUNCHED",
              "PRODUCT_DEPLOYED",
              "AGENT_ASSIGNED",
              "AGENT_COMPLETED",
              "TOOL_EXECUTED",
              "TOOL_GRANTED",
              "CARKEYS_APPROVED",
              "CARKEYS_REVOKED",
              "MODEL_INFERENCE",
              "DATA_EXPORTED",
              "RECEIPT_VERIFIED"
            ],
            "description": "Type of action being recorded"
          },
          "product": {
            "type": "string",
            "description": "Product involved (e.g., 'RoadOS', 'RoadCode', 'RoadChain')"
          },
          "agent": {
            "type": "string",
            "description": "Agent involved (if applicable)"
          },
          "tool": {
            "type": "string",
            "description": "Tool involved (if applicable)"
          },
          "carkeys_lane": {
            "type": "string",
            "description": "CarKeys lane involved (if permission-related)"
          },
          "metadata": {
            "type": "object",
            "description": "Action-specific metadata (structure varies by action type)"
          },
          "verification_signature": {
            "type": "string",
            "description": "Cryptographic signature for verification (base64-encoded)"
          },
          "notes": {
            "type": "string",
            "description": "Human-readable notes about this receipt"
          }
        }
      }
    }
  }
}
