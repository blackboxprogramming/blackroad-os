{
  "schema_version": 3,
  "root": ".",
  "connector_runtime": {
    "id": "blackroad-connectors-production",
    "transport": "connector_rpc",
    "dispatch": ["road-connectors", "invoke", "--json-stdin"]
  },
  "runtime": {
    "state_file": ".road-credentials/state.json",
    "receipt_dir": ".road-credentials/receipts"
  },
  "scan": {
    "ignore_file": ".roadcredentialsignore",
    "max_file_bytes": 2000000,
    "history_max_bytes": 25000000,
    "reference_ignore_paths": ["README.md", "docs/**", "tests/**", "examples/**"]
  },
  "credentials": [
    {
      "id": "github-ci-control",
      "connector": "github",
      "risk": "critical",
      "provider_id": "replace-with-non-secret-provider-id",
      "auto_heal": false,
      "detect": {
        "kinds": ["github_token"],
        "names": ["GITHUB_CONTROL_TOKEN"],
        "paths": [".env*", "**/.env*", ".github/**", "config/**"],
        "fingerprints": []
      },
      "lifecycle": {
        "authorize_action": "carkeys.rotation.authorize",
        "create_action": "github.credential.create",
        "validate_action": "github.credential.validate",
        "activate_action": "github.credential.activate",
        "restore_action": "github.credential.restore",
        "revoke_old_action": "github.credential.revoke-old",
        "revoke_new_action": "github.credential.revoke-new"
      },
      "consumers": [
        {
          "id": "github-actions-primary",
          "paths": [".github/workflows/**", ".env*", "config/**"],
          "update_action": "github.consumer.update",
          "verify_action": "github.consumer.verify",
          "rollback_action": "github.consumer.rollback"
        }
      ]
    }
  ]
}
